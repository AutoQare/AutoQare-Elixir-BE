# AutoQare backend's env file: copy to ~/sites/<api host>/.env, fill in, chmod 600.
# `export` on every line: the release is a child of the shell that sources this.
# A change needs a restart, not a rebuild. `config/runtime.exs` (through
# `Autoqare.RuntimeEnv`) reads these and refuses to boot production without the
# required ones, naming what is missing. `bin/autoqare eval` boots the same way,
# so source this before a migration or a seed too (DEPLOY-PLAN §6).
#
# Example values are the remote dev host's. Every secret is CHANGE_ME: generate
# real ones on the box (D-10) and never commit them.

# ============================== REQUIRED =====================================

# >= 64 bytes each (`mix phx.gen.secret` or `openssl rand -base64 48`),
# different from each other and per environment.
export SECRET_KEY_BASE=CHANGE_ME
export GUARDIAN_SECRET_KEY=CHANGE_ME_DIFFERENT_FROM_ABOVE

# The database, as pieces (D-5; Jenkins' reset job uses the prefix AQ) ...
export AQ_DB_HOST=127.0.0.1
export AQ_DB_NAME=autoqare_dev
export AQ_DB_USER=autoqare
export AQ_DB_PWD=CHANGE_ME
# ... or as one URL, which wins when set:
# export DATABASE_URL=ecto://USER:CHANGE_ME@HOST:5432/autoqare_prod

# Must match proxy_pass in this host's nginx site (README.autoqare.md):
# dev 4901, staging 4902, prod 4901, the office's dev1 4911. Default 4100.
export PORT=4901

# The apps that may call the API and open its socket, comma-separated: the
# team console and the customer portal. An allowlist, never `*`.
export CORS_ORIGINS=https://dev.team.autoqare.com,https://dev.autoqare.com

# Where every email and invitation link opens: the console and the portal.
export CONSOLE_URL=https://dev.team.autoqare.com
export PORTAL_URL=https://dev.autoqare.com

# Uploaded files (photos, CVs, imports). A directory on persistent storage,
# OUTSIDE the release directory, owned by the user this runs as.
export UPLOADS_ROOT=/home/ubuntu/sites/dev.be.autoqare.com/uploads

# The mailer (D-4): ses (the servers) | local (nothing leaves the box).
export MAILER_ADAPTER=ses
# With ses: an IAM key allowed ses:SendRawEmail, in the region autoqare.com is verified in.
export AWS_SES_REGION=eu-west-1
export AWS_ACCESS_KEY_ID=CHANGE_ME
export AWS_SECRET_ACCESS_KEY=CHANGE_ME
# The envelope sender: an address on a domain SES has verified.
export MAILER_FROM_EMAIL=hello@autoqare.com

# ============================== OPTIONAL =====================================

# export AQ_DB_PORT=5432
# export POOL_SIZE=10
# emergency | alert | critical | error | warning | notice | info | debug
# export LOG_LEVEL=info

# D-9: remote dev ONLY. Lets this release accept the standard test password
# (the worst-list refuses it otherwise) and run
# `bin/autoqare eval "Autoqare.Release.seed_standard()"`. Staging and production never set it.
# export AQ_ALLOW_TEST_PASSWORDS=true

# This backend's own origin, for the emails' one-click unsubscribe
# (List-Unsubscribe). Unset, it is http://localhost:4100, so set it on every server.
# export API_URL=https://dev.be.autoqare.com
# Notification mail's sender: "<Organisation> via AutoQare" <this>.
# export MAILER_NOTIFICATIONS_EMAIL=notifications@autoqare.com

# *Continue with Google* (D-15). Unset: no Google sign-in in a release.
# export GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# Web Push. Unset: no push, and the screens say so. One P-256 pair per environment, base64url:
#   mix run -e '{p, k} = :crypto.generate_key(:ecdh, :prime256v1); IO.puts(Base.url_encode64(p, padding: false)); IO.puts(Base.url_encode64(k, padding: false))'
# export VAPID_PUBLIC_KEY=CHANGE_ME
# export VAPID_PRIVATE_KEY=CHANGE_ME
# export VAPID_SUBJECT=mailto:support@autoqare.com

# Forwarded mail (D-12). The address with {token}; the webhook's basic-auth pair,
# put in Postmark's inbound URL (https://USER:PASSWORD@<api host>/inbound/email).
# Unset password: POST /inbound/email answers 503 inbound_off.
# export INBOUND_ADDRESS=in+{token}@in.autoqare.com
# export INBOUND_USER=postmark
# export INBOUND_PASSWORD=CHANGE_ME

# Seeding needs no variable: on a fresh database, after migrate,
#   bin/autoqare eval "Autoqare.Release.seed()"
#   bin/autoqare eval 'Autoqare.Release.bootstrap("<Organisation>", "<admin email>", "<Name>")'
# With ses the invitation is emailed and no link is printed; with local the link is printed.
