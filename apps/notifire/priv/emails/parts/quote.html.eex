<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:16px 0 0 0;">
  <tr>
    <td style="border-left:3px solid #0E7C86;padding:4px 0 4px 14px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:22px;color:#14171C;white-space:pre-line;"><%= @text %></td>
  </tr>
</table>
