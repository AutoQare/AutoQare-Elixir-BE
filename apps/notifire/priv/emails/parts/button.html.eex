<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin:24px 0 8px 0;border-collapse:separate;">
  <tr>
    <td align="center" bgcolor="#0E7C86" style="border-radius:8px;background-color:#0E7C86;">
      <a href="<%= @url %>" target="_blank" style="display:inline-block;padding:12px 24px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;line-height:20px;color:#FFFFFF;text-decoration:none;border-radius:8px;border:1px solid #0E7C86;background-color:#0E7C86;mso-padding-alt:0;"><%= @label %></a>
    </td>
  </tr>
</table>
