<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin:16px 0 0 0;border:1px solid #DEE1E6;border-radius:8px;border-collapse:separate;">
<%= for {label, value} <- @rows do %>  <tr>
    <td valign="top" style="padding:8px 12px;width:34%;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;color:#5C6572;"><%= label %></td>
    <td valign="top" style="padding:8px 12px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:18px;color:#14171C;"><%= value %></td>
  </tr>
<% end %></table>
