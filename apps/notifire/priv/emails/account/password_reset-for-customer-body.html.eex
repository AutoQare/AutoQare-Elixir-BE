<%= greeting(@first_name) %>
<%= heading(@title) %>
<%= paragraph("Somebody asked to reset the password for this account.") %>
<%= paragraph(@body) %>
<%= facts(@facts) %>
<%= button("Choose a new password", @url) %>
<%= link(@url) %>
<%= paragraph("The link works once and expires in an hour. If this wasn’t you, ignore this email: nothing has changed and your password still works.") %>
