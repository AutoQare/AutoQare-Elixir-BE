<%= greeting(@first_name) %>
<%= heading(@title) %>
<%= paragraph(@body) %>
<%= facts(@facts) %>
<%= button("Accept the invitation", @url) %>
<%= link(@url) %>
<p style="margin:12px 0 0 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;color:#5C6572;">The link works once and expires on <%= escape(@expires_on) %>.</p>
