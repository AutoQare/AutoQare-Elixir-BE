<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>AutoQare emails</title>
  <style>
    :root { color-scheme: light dark; }
    body { margin: 0; padding: 24px 16px; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #F5F6F8; color: #14171C; }
    h1 { font-size: 22px; margin: 0 0 4px; }
    p.lede { margin: 0 0 20px; color: #5C6572; font-size: 14px; }
    table { width: 100%; max-width: 980px; border-collapse: collapse; background: #FFFFFF; border: 1px solid #DEE1E6; border-radius: 10px; overflow: hidden; }
    th, td { text-align: left; padding: 8px 12px; border-top: 1px solid #DEE1E6; font-size: 14px; vertical-align: top; }
    th { background: #F5F6F8; font-weight: 600; border-top: 0; }
    a { color: #0E7C86; }
    code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 13px; }
    .muted { color: #5C6572; }
    @media (prefers-color-scheme: dark) {
      body { background: #0F1216; color: #E8EAED; }
      table { background: #181C22; border-color: #2A3038; }
      th { background: #1F242B; }
      th, td { border-color: #2A3038; }
      .muted, p.lede { color: #9AA3AE; }
    }
  </style>
</head>
<body>
  <h1>AutoQare emails</h1>
  <p class="lede">Every template with sample data (AQ-10B §7.3), staff and customer, HTML beside plain text. A dev server only.</p>
  <table>
    <tr><th>Kind</th><th>Audience</th><th>Email</th></tr>
<%= for row <- @rows do %>    <tr>
      <td><code><%= escape(row.kind) %></code><br><span class="muted"><%= escape(row.label) %></span></td>
      <td><%= escape(row.audience) %></td>
      <td><a href="<%= escape(row.html) %>">HTML</a> &middot; <a href="<%= escape(row.text) %>">plain text</a><%= if row.no_login do %> &middot; <a href="<%= escape(row.no_login) %>">no portal login</a><% end %></td>
    </tr>
<% end %>  </table>
</body>
</html>
