<%= greeting(@first_name) %>
<%= heading(@title) %>
<%= paragraph("The invite is attached: add it to your calendar.") %>
<%= paragraph(@body) %>
<%= facts(@facts) %>
<%= button("See your meetings", @url) %>
<%= link(@url) %>
<%= if @no_login do %><%= paragraph("Ask your team for a portal invitation to see everything.") %><% end %>
